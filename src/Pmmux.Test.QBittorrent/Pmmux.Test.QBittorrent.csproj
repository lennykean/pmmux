    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pmmux.Extensions.QBittorrent\Pmmux.Extensions.QBittorrent.csproj" />
  </ItemGroup>
</Project>
